QMainWindow { background-color: #f8fafc; color: #0f172a; }
QWidget { color: #0f172a; background-color: #f8fafc; font-size: 10pt; }
QMenuBar, QMenu, QStatusBar, QToolBar { background-color: #e2e8f0; color: #0f172a; }
QPushButton, QComboBox, QLineEdit, QTreeView, QTreeWidget, QListWidget, QTextEdit, QPlainTextEdit {
  background-color: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 4px; padding: 4px;
}
QPushButton:hover { background-color: #dbeafe; }
